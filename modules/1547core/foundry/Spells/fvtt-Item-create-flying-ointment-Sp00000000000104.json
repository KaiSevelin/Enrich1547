        "props": {
            "Description": "A transgressive necromantic working that renders a flying ointment from forbidden matter. The witch lies with an unnatural of the infernal domain and devil role, carries and bears its offspring, then boils that offspring down into a pale grease. Smeared upon a broom, a beast, or any bearing thing, the ointment lifts it into the night air. It sits at the far, dangerous end of the craft, demanding steadiness, secrecy, and someone willing to bear its cost.",
            "SpellKind": "Necromancy",
            "Strength": 3,
            "Complexity": "Hard",
            "RitualProfile": "Necromancy",
            "SchoolRequirementMode": "Any",
            "FailureProfile": "Catastrophic",
            "RandomOutcome": false,
            "SpellNotes": "Canonical effect: on success the caster renders one jar of flying ointment, which grants flight for one hour to a beast or an inanimate object. The rite always requires congress with an infernal Devil-role unnatural and the boiling of the resulting offspring.",
            "SchoolRequirementsTable": [
                {
                    "School": "Necromancy",
                    "Level": 3
                }
            ],
            "PrerequisitesTable": [
                {
                    "RequirementType": "Item",
                    "RequirementTarget": "A cauldron and rendering fire, and an infernal-sired offspring",
                    "RequirementLevel": 1,
                    "RequirementNotes": "The rite consumes the offspring conceived with an infernal Devil-role unnatural."
                }
            ],
            "StaticRitualSteps": [
                {
                    "StepScope": "Mandatory",
                    "AlternativeGroup": "",
                    "StepType": "StaticSkill",
                    "StepText": "Meet the Necromancy school casting requirement.",
                    "SkillCheck": "Pagan Expertise Necromancy or Learning Expertise Occult",
                    "Difficulty": "3",
                    "StepNotes": "Static core school requirement.",
                    "Icon": "fa-graduation-cap",
                    "Tooltip": "Meet the Necromancy school casting requirement. (average)"
                },
                {
                    "StepScope": "Mandatory",
                    "AlternativeGroup": "",
                    "StepType": "RareMaterial",
                    "StepText": "Lie with an unnatural of the Infernal domain and Devil role, and conceive its offspring.",
                    "SkillCheck": "",
                    "Difficulty": "",
                    "StepNotes": "Always required. The ointment can only be rendered from an infernal-sired offspring.",
                    "Icon": "fa-gem",
                    "Tooltip": "Lie with an infernal Devil-role unnatural and conceive its offspring. (required condition, no roll)"
                },
                {
                    "StepScope": "Mandatory",
                    "AlternativeGroup": "",
                    "StepType": "AlchemicalOperation",
                    "StepText": "Boil the offspring down to render the flying ointment.",
                    "SkillCheck": "",
                    "Difficulty": "",
                    "StepNotes": "Always required. Render the ointment by boiling the offspring.",
                    "Icon": "fa-flask",
                    "Tooltip": "Boil the offspring to render the ointment. (required condition, no roll)"
                }
            ],
