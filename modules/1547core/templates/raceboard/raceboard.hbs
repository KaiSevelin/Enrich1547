<div class="rb-body"><header class="rb-header">
  <h2 class="rb-doc-name">
    {{#if isEphemeral}}
      <span class="rb-ephemeral-tag">{{localize "RACEBOARD.Unsaved"}}</span>
    {{else}}
      {{docName}}
    {{/if}}
  </h2>
  {{#if canEdit}}
    <div class="rb-header-actions">
      <button type="button" class="rb-btn rb-btn-icon" data-action="reset"
              title="{{localize "RACEBOARD.Reset"}}">
        <i class="fa-solid fa-rotate-left"></i>
      </button>
      <button type="button" class="rb-btn rb-btn-icon rb-btn-danger" data-action="discard"
              title="{{#if isEphemeral}}{{localize "RACEBOARD.CloseUnsaved"}}{{else}}{{localize "RACEBOARD.Discard"}}{{/if}}">
        <i class="fa-solid fa-{{#if isEphemeral}}xmark{{else}}trash{{/if}}"></i>
      </button>
    </div>
  {{/if}}
</header>

{{#if resolution.show}}
  <div class="rb-resolution {{resolution.cssClass}}">
    <i class="fa-solid {{resolution.icon}}"></i>
    <span class="rb-resolution-label">{{resolution.label}}</span>
    {{#if resolution.canResolve}}
      <button type="button" class="rb-btn rb-btn-icon" data-action="resolve-clear"
              title="{{localize "RACEBOARD.ResolveClearTitle"}}">
        <i class="fa-solid fa-rotate-left"></i>
      </button>
    {{/if}}
  </div>
{{/if}}

{{#if alarm.show}}
  <div class="rb-alarm" data-alarm-level="{{alarm.level}}">
    <span class="rb-alarm-icon"
          {{#if alarm.canControl}}data-action="alarm-up" title="{{localize "RACEBOARD.AlarmIconTitle"}}"{{/if}}>
      <i class="fa-solid {{alarm.icon}}"></i>
    </span>
    <span class="rb-alarm-label">{{alarm.label}}</span>
    {{#if alarm.canControl}}
      <div class="rb-alarm-controls">
        <button type="button" class="rb-btn rb-btn-icon rb-btn-danger" data-action="alarm-remove"
                title="{{localize "RACEBOARD.AlarmRemove"}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    {{/if}}
  </div>
{{/if}}

{{#if header.show}}
  <div class="rb-header-row">
    <div class="rb-boxes rb-header-boxes">
      {{#each header.cells}}
        <span class="rb-box rb-header-cell{{#if ../canEdit}} rb-header-editable{{/if}}"
              title="{{tooltip}}"
              {{#if ../canEdit}}data-action="edit-header" data-col="{{@index}}"{{/if}}>
          <i class="fa-solid {{icon}}"></i>
        </span>
      {{/each}}
    </div>
  </div>
{{/if}}

<div class="rb-rows">
  {{#each rows}}
    <div class="rb-row {{#if isWon}}is-won{{/if}}" data-row="{{idx}}">
      <div class="rb-row-label">
        <span class="rb-label-text"
              {{#if ../canEdit}}data-action="edit-label" data-row="{{idx}}" title="{{localize "RACEBOARD.EditLabelTitle"}}"{{/if}}>
          {{label}}
        </span>
        <span class="rb-row-progress">{{filled}}/{{total}}</span>
      </div>

      <div class="rb-row-body">
        <div class="rb-boxes">
          {{#each boxes}}
            <span class="rb-box {{#if checked}}is-checked{{/if}} {{#if reached}}is-reached{{/if}}"
                  data-event-state="{{eventState}}"
                  {{#if ../../canEdit}}data-action="tick" data-row="{{../idx}}" data-box="{{idx}}" title="{{localize "RACEBOARD.MarkEventTitle"}}"{{/if}}>
              <i class="fa-{{#if checked}}solid{{else}}regular{{/if}} fa-square{{#if checked}}-check{{/if}}"></i>
            </span>
          {{/each}}
        </div>

        {{#if ../canEdit}}
          <div class="rb-row-controls">
            <button type="button" class="rb-btn rb-btn-icon" data-action="row-remove-box" data-row="{{idx}}"
                    {{#unless canRemoveBox}}disabled{{/unless}}
                    title="{{localize "RACEBOARD.RemoveBox"}}">
              <i class="fa-solid fa-minus"></i>
            </button>
            <button type="button" class="rb-btn rb-btn-icon" data-action="row-add-box" data-row="{{idx}}"
                    title="{{localize "RACEBOARD.AddBox"}}">
              <i class="fa-solid fa-plus"></i>
            </button>
            <button type="button" class="rb-btn rb-btn-icon rb-btn-danger" data-action="row-delete" data-row="{{idx}}"
                    {{#unless ../canDeleteRow}}disabled{{/unless}}
                    title="{{localize "RACEBOARD.DeleteTrack"}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{/if}}
      </div>
    </div>
  {{/each}}
</div>

{{#if canEdit}}
  <footer class="rb-footer">
    <button type="button" class="rb-btn" data-action="add-row"
            {{#unless canAddRow}}disabled{{/unless}}
            title="{{localize "RACEBOARD.AddTrackTitle"}}">
      <i class="fa-solid fa-plus"></i> {{localize "RACEBOARD.AddTrackShort"}}
    </button>
    {{#unless alarm.enabled}}
      <button type="button" class="rb-btn" data-action="alarm-add"
              title="{{localize "RACEBOARD.AddAlarm"}}">
        <i class="fa-solid fa-bell"></i> {{localize "RACEBOARD.AddAlarmShort"}}
      </button>
    {{/unless}}

    <div class="rb-reveal" role="radiogroup" aria-label="{{localize "RACEBOARD.RevealAria"}}">
      <span class="rb-reveal-label">{{localize "RACEBOARD.RevealLabel"}}</span>
      {{#each visibilityOptions}}
        <button type="button" role="radio" aria-checked="{{active}}"
                class="rb-btn rb-btn-icon rb-reveal-btn {{#if active}}is-active{{/if}}"
                data-action="set-visibility" data-level="{{level}}"
                title="{{localize titleKey}}">
          <i class="fa-solid {{icon}}"></i>
        </button>
      {{/each}}
    </div>

    {{#if resolution.canResolve}}{{#unless resolution.resolved}}
      <div class="rb-resolve">
        <span class="rb-resolve-label">{{localize "RACEBOARD.ResolveLabel"}}</span>
        <button type="button" class="rb-btn rb-btn-success" data-action="resolve-success"
                title="{{localize "RACEBOARD.ResolveSuccessTitle"}}">
          <i class="fa-solid fa-circle-check"></i> {{localize "RACEBOARD.ResolveSuccess"}}
        </button>
        <button type="button" class="rb-btn rb-btn-danger" data-action="resolve-failure"
                title="{{localize "RACEBOARD.ResolveFailureTitle"}}">
          <i class="fa-solid fa-circle-xmark"></i> {{localize "RACEBOARD.ResolveFailure"}}
        </button>
      </div>
    {{/unless}}{{/if}}

    <div class="rb-footer-right">
      {{#if isEphemeral}}
        <button type="button" class="rb-btn rb-btn-primary" data-action="save"
                title="{{localize "RACEBOARD.SaveButtonTitle"}}">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "RACEBOARD.SaveLabel"}}
        </button>
      {{/if}}
    </div>
  </footer>
{{/if}}
</div>
