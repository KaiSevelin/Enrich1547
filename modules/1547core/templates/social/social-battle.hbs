<div class="sb-wrap">
  <div class="sb-sides">
    {{#each sides}}
      <div class="sb-side{{#if this.isLoser}} is-loser{{/if}}{{#if this.isWinner}} is-winner{{/if}}">
        <div class="sb-side-head">
          <span class="sb-side-name" title="{{this.drivesTooltip}}">{{this.name}}</span>
          <span class="sb-side-stat" title="Battle stat (sets marks)">{{this.stat}}</span>
        </div>

        <div class="sb-side-controls">
          <div class="sb-modes">
            <div class="sb-mode-row">
              <label class="sb-mode-pick" title="Roll a stat"><input type="radio" name="mode-{{this.key}}" value="stat" {{#if this.isStat}}checked{{/if}}></label>
              <select name="stat-{{this.key}}" class="sb-sel" title="Stat to roll">
                {{#each this.statOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>{{/each}}
              </select>
            </div>
            <div class="sb-mode-row">
              <label class="sb-mode-pick" title="Roll a skill"><input type="radio" name="mode-{{this.key}}" value="skill" {{#if this.isSkill}}checked{{/if}}></label>
              <select name="skill-{{this.key}}" class="sb-sel" title="Skill to roll">
                <option value="">— skill —</option>
                {{#each this.skillOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
              </select>
            </div>
          </div>

          <div class="sb-adv" title="Advantage / disadvantage dice">
            {{#each this.advOptions}}
              <label class="sb-adv-opt"><input type="radio" name="adv-{{../key}}" value="{{this.value}}" {{#if this.checked}}checked{{/if}}><span>{{this.label}}</span></label>
            {{/each}}
          </div>

          <div class="sb-secrets">
            <label class="sb-secret" title="Use a secret this exchange (+1 die)"><input type="checkbox" name="secret-{{this.key}}" {{#if this.secret}}checked{{/if}}><i class="fa-solid fa-key"></i> Secret</label>
          </div>
        </div>

        <div class="sb-pips" title="{{this.taken}} of {{this.total}} marks">
          {{#each this.pips}}<span class="sb-pip{{#if this}} is-filled{{/if}}"></span>{{/each}}
        </div>
        <div class="sb-marks">
          <button type="button" class="sb-mini" data-action="mark-remove" data-side="{{this.key}}" title="Remove a mark box"><i class="fa-solid fa-minus"></i></button>
          <span class="sb-marks-count">{{this.taken}} / {{this.total}}</span>
          <button type="button" class="sb-mini" data-action="mark-add" data-side="{{this.key}}" title="Add a mark box"><i class="fa-solid fa-plus"></i></button>
        </div>
      </div>
    {{/each}}
  </div>

  {{#if over}}
    <div class="sb-outcome">
      <span class="sb-outcome-label"><i class="fa-solid fa-gavel"></i> {{loser.name}} loses</span>
      <div class="sb-outcome-actions">
        <button type="button" class="sb-btn" data-action="grant-drive"
                title="Grant a Drive to {{loser.name}} (chargen Drives model)">
          <i class="fa-solid fa-fire-flame-curved"></i>
        </button>
        <button type="button" class="sb-btn" data-action="grant-mood"
                title="Grant a Mood to {{loser.name}} (cleared on rest)">
          <i class="fa-solid fa-cloud"></i>
        </button>
      </div>
    </div>
  {{else}}
    <div class="sb-controls">
      <button type="button" class="sb-btn sb-exchange" data-action="exchange" title="Roll an exchange">
        <i class="fa-solid fa-dice"></i>
      </button>
    </div>
  {{/if}}

  {{#if log.length}}
    <div class="sb-log">
      {{#each log}}<div class="sb-log-line">{{this}}</div>{{/each}}
    </div>
  {{/if}}

  <div class="sb-footer">
    <button type="button" class="sb-btn" data-action="reset" title="Reset marks and log">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
  </div>
</div>
