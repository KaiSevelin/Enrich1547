<form class="flexcol">
  <section class="sheet-body">
    <div class="form-group">
      <label>Module Version</label>
      <div>{{moduleVersion}}</div>
    </div>

    <div class="form-group">
      <label>Stored Maneuvers</label>
      <div>{{storedManeuverCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Weapons</label>
      <div>{{storedWeaponCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Armors</label>
      <div>{{storedArmorCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Ammunition</label>
      <div>{{storedAmmoCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Spells</label>
      <div>{{storedSpellCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Ritual Step Roll Tables</label>
      <div>{{storedRitualStepRollTableCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Spell Failure Roll Tables</label>
      <div>{{storedSpellFailureRollTableCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Spell Support Roll Tables</label>
      <div>{{storedSpellSupportRollTableCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Monsters</label>
      <div>{{storedMonsterCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Change Sets</label>
      <div>{{storedChangeSetCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Changes</label>
      <div>{{storedChangeCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Requirements</label>
      <div>{{storedRequirementCount}}</div>
    </div>

    <div class="form-group">
      <label>Chargen Items</label>
      <div>{{storedChargenItemCount}}</div>
    </div>

    <div class="form-group">
      <label>Chargen Roll Tables</label>
      <div>{{storedChargenRollTableCount}}</div>
    </div>

    <div class="form-group">
      <label>Last Setup</label>
      <div>{{#if lastDataSetupAt}}{{lastDataSetupAt}}{{else}}Not run yet{{/if}}</div>
    </div>

    <p class="notes">
      Setup Data loads the module's maneuver, weapon, armor, ammunition,
      spell, ritual-step roll table, spell-failure roll table, spell-support roll table, monster, change set, change, and
      requirement datasets into world settings, writes the live templates,
      creates the managed Actor, Item, and RollTable folder structure,
      immediately syncs matching world documents from that source data, and
      imports the character-generator content (life-path tables, Your Nature,
      body tables). One pass sets up everything the system needs; it can take
      some minutes.
    </p>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="setup-data">
      <i class="fas fa-database"></i>
      Setup Data
    </button>
    <button type="button" data-action="run-diagnostics">
      <i class="fas fa-stethoscope"></i>
      Run Diagnostics
    </button>
  </footer>
</form>
