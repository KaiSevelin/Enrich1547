<form class="flexcol">
  <section class="sheet-body">
    <div class="form-group">
      <label>Module Version</label>
      <div>{{moduleVersion}}</div>
    </div>

    <div class="form-group">
      <label>Stored Maneuvers</label>
      <div>{{storedManeuverCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Weapons</label>
      <div>{{storedWeaponCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Armors</label>
      <div>{{storedArmorCount}}</div>
    </div>

    <div class="form-group">
      <label>Stored Ammunition</label>
      <div>{{storedAmmoCount}}</div>
    </div>

    <div class="form-group">
      <label>Last Setup</label>
      <div>{{#if lastDataSetupAt}}{{lastDataSetupAt}}{{else}}Not run yet{{/if}}</div>
    </div>

    <p class="notes">
      Setup Data loads the module's maneuver, weapon, armor, and ammunition
      datasets into world settings, writes the live item templates, and
      immediately syncs matching world items from that source data.
    </p>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="setup-data">
      <i class="fas fa-database"></i>
      Setup Data
    </button>
  </footer>
</form>
