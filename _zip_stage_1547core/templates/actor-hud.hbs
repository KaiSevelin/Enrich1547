{{#if hasActor}}
<section class="hud-shell">
  <header class="hud-header">
    <div class="hud-header-main">
      <img class="hud-portrait" src="{{actorImg}}" alt="{{actorName}}">
      <div>
        <h2>{{tokenName}}</h2>
        <p>{{actorName}}</p>
      </div>
    </div>
    <div class="hud-combat-state">
      <div><strong>Combat:</strong> {{#if isCombatActive}}Active{{else}}Inactive{{/if}}</div>
      {{#if round}}<div><strong>Round:</strong> {{round}}</div>{{/if}}
      {{#if activeCombatantName}}<div><strong>Active:</strong> {{activeCombatantName}}</div>{{/if}}
      <div><strong>Turn:</strong> {{#if isSelectedActorCombatant}}Current actor{{else}}Other actor{{/if}}</div>
    </div>
  </header>

  <section class="hud-summary-grid">
    <div class="hud-card">
      <h3>Action State</h3>
      <div class="hud-stat-row"><span>Movement</span><strong>{{#if actions.movement}}{{actions.movement}}{{else}}-{{/if}}</strong></div>
      <div class="hud-stat-row"><span>Attacks</span><strong>{{#if actions.attacks}}{{actions.attacks}}{{else}}-{{/if}}</strong></div>
      <div class="hud-stat-row"><span>Full Turn</span><strong>{{actions.fullTurnAvailable}}</strong></div>
      <div class="hud-stat-row"><span>Done</span><strong>{{actions.done}}</strong></div>
    </div>

    <div class="hud-card">
      <h3>Resources</h3>
      <div class="hud-resource-grid">
        {{#each resources}}
        <div class="hud-resource-pill">
          <span>{{label}}</span>
          <strong>{{value}}</strong>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <section class="hud-summary-grid">
    <div class="hud-card">
      <h3>Weapons</h3>
      {{#if equippedWeapons.length}}
      <ul class="hud-list">
        {{#each equippedWeapons}}
        <li>
          <div class="hud-list-title">{{name}}</div>
          <div class="hud-list-sub">{{type}}{{#if reach}} - Reach {{reach}}{{/if}}{{#if ready}} - Ready{{/if}}</div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hud-empty">No equipped or ready weapons.</p>
      {{/if}}
    </div>

    <div class="hud-card">
      <h3>Armor</h3>
      {{#if equippedArmor.length}}
      <ul class="hud-list">
        {{#each equippedArmor}}
        <li>
          <div class="hud-list-title">{{name}}</div>
          <div class="hud-list-sub">{{armorType}}{{#if defense}} - {{defense}}{{/if}}</div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hud-empty">No equipped armor.</p>
      {{/if}}
    </div>
  </section>

  <section class="hud-card">
    <h3>Action Categories</h3>
    <div class="hud-category-grid">
      {{#each categories}}
      <div class="hud-category">
        <div class="hud-category-head">
          <h4>{{label}}</h4>
          <button type="button" data-placeholder-action="{{label}}">Open</button>
        </div>
        {{#if entries.length}}
        <ul class="hud-list">
          {{#each entries}}
          <li>
            <div class="hud-list-title">{{label}}</div>
            {{#if sublabel}}<div class="hud-list-sub">{{sublabel}}</div>{{/if}}
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="hud-empty">No entries yet.</p>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>

  <section class="hud-summary-grid">
    <div class="hud-card">
      <h3>Conditions</h3>
      {{#if conditions.length}}
      <ul class="hud-list">
        {{#each conditions}}
        <li class="hud-effect-row">
          {{#if icon}}<img class="hud-effect-icon" src="{{icon}}" alt="{{name}}">{{/if}}
          <span>{{name}}</span>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hud-empty">No active conditions.</p>
      {{/if}}
    </div>

    <div class="hud-card">
      <h3>Persistent Effects</h3>
      {{#if persistentEffects.length}}
      <ul class="hud-list">
        {{#each persistentEffects}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{else}}
      <p class="hud-empty">No persistent effects tracked yet.</p>
      {{/if}}
      <p class="hud-meta">{{maneuverCount}} learned maneuvers on actor.</p>
    </div>
  </section>
</section>
{{else}}
<section class="hud-shell">
  <p class="hud-empty">Select a token to view the 1547 HUD.</p>
</section>
{{/if}}
